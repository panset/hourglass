load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "app",
    srcs = [
        "app.go",
        "checkprovider.go",
        "metrics.go",
        "seed.go",
        "storedreports.go",
    ],
    importpath = "github.com/panset/hourglass/internal/app",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/api",
        "//internal/app/runhook",
        "//internal/auth",
        "//internal/collector",
        "//internal/config",
        "//internal/events",
        "//internal/holds",
        "//internal/ledger",
        "//internal/reported",
        "//internal/rules",
        "//internal/servetls",
        "//internal/settings",
        "//internal/store",
        "//internal/uiserve",
        "//pkg/hourglass",
        "//pkg/storedreports",
    ],
)

go_test(
    name = "app_test",
    srcs = [
        "app_test.go",
        "checkprovider_test.go",
        "metrics_test.go",
        "seed_test.go",
        "storedreports_test.go",
    ],
    embed = [":app"],
    deps = [
        "//internal/app/runhook",
        "//internal/collector",
        "//internal/reported",
        "//internal/servetls/servetlstest",
        "//internal/settings",
        "//internal/store",
        "//pkg/hourglass",
        "//pkg/hourglasstest",
        "//pkg/storedreports",
    ],
)

# The source scan in internal/api/registration_test.go reads these files.
filegroup(
    name = "go_sources",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    visibility = ["//internal/api:__pkg__"],
)
