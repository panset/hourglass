# SPDX-License-Identifier: MIT
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "apierr",
    srcs = ["apierr.go"],
    importpath = "github.com/panset/hourglass/internal/api/apierr",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "apierr_test",
    srcs = ["apierr_test.go"],
    embed = [":apierr"],
)

# The source scan in internal/api/registration_test.go reads these files.
filegroup(
    name = "go_sources",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    visibility = ["//internal/api:__pkg__"],
)
