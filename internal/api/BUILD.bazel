load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "api",
    srcs = [
        "admin_common.go",
        "admin_system.go",
        "admin_views.go",
        "api.go",
        "handlers_admin.go",
        "handlers_user.go",
        "health.go",
        "helpers.go",
        "middleware.go",
        "routes.go",
        "user_views.go",
    ],
    importpath = "github.com/panset/hourglass/internal/api",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/api/apierr",
        "//internal/auth",
        "//internal/collector",
        "//internal/events",
        "//internal/holds",
        "//internal/ledger",
        "//internal/metering",
        "//internal/rules",
        "//internal/settings",
        "//internal/store",
        "//pkg/hourglass",
    ],
)

go_test(
    name = "api_test",
    srcs = [
        "admin_setups_test.go",
        "admin_system_test.go",
        "admin_testenv_test.go",
        "admin_users_test.go",
        "contract_test.go",
        "helpers_test.go",
        "permissions_test.go",
        "router_test.go",
        "testenv_test.go",
        "user_test.go",
        "user_testenv_test.go",
    ],
    data = [
        # The contract test reads the OpenAPI file and the permissions test the
        # spec's table; both are found by walking up from the runfiles directory.
        "//:api/openapi.yaml",
        "//:docs/SPEC.md",
    ],
    embed = [":api"],
    deps = [
        "//internal/api/apierr",
        "//internal/auth",
        "//internal/collector",
        "//internal/events",
        "//internal/holds",
        "//internal/ledger",
        "//internal/settings",
        "//internal/store",
        "//pkg/hourglass",
        "//pkg/hourglasstest",
        "@com_github_getkin_kin_openapi//openapi3",
        "@com_github_getkin_kin_openapi//openapi3filter",
        "@com_github_getkin_kin_openapi//routers",
        "@com_github_getkin_kin_openapi//routers/legacy",
    ],
)
