# SPDX-License-Identifier: MIT
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "api",
    srcs = [
        "admin_common.go",
        "admin_system.go",
        "admin_views.go",
        "api.go",
        "handlers_admin.go",
        "handlers_integration.go",
        "handlers_service.go",
        "handlers_user.go",
        "health.go",
        "helpers.go",
        "middleware.go",
        "routes.go",
        "user_views.go",
    ],
    importpath = "github.com/panset/hourglass/internal/api",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/api/apierr",
        "//internal/auth",
        "//internal/collector",
        "//internal/events",
        "//internal/holds",
        "//internal/ledger",
        "//internal/metering",
        "//internal/reported",
        "//internal/rules",
        "//internal/settings",
        "//internal/store",
        "//pkg/hourglass",
    ],
)

go_test(
    name = "api_test",
    srcs = [
        "admin_responses_test.go",
        "admin_setups_test.go",
        "admin_system_test.go",
        "admin_testenv_test.go",
        "admin_users_test.go",
        "contract_test.go",
        "greeting_test.go",
        "helpers_test.go",
        "integration_reports_test.go",
        "ledger_view_test.go",
        "perf_compaction_scale_test.go",
        "perf_scale_test.go",
        "permissions_test.go",
        "race_off_test.go",
        "race_on_test.go",
        "registration_test.go",
        "release_pending_test.go",
        "router_test.go",
        "service_accounts_test.go",
        "service_testenv_test.go",
        "setups_label_index_test.go",
        "testenv_test.go",
        "user_test.go",
        "user_testenv_test.go",
    ],
    data = [
        # The contract test reads the OpenAPI file and the permissions test the
        # spec's table; both are found by walking up from the runfiles directory.
        "//:api/openapi.yaml",
        "//:docs/SPEC.md",
        # The LED-11 test compares with responses recorded from the handler as it
        # was before the ledger view parameters existed.
        "testdata/led11_pre_change_responses.json",
        # The registration scan (registration_test.go) reads the sources of these packages.
        ":go_sources",
        "//cmd/hourglass-ui:go_sources",
        "//cmd/hourglassd:go_sources",
        "//internal/api/apierr:go_sources",
        "//internal/app:go_sources",
        "//internal/app/runhook:go_sources",
        "//internal/auth:go_sources",
    ],
    embed = [":api"],
    deps = [
        "//internal/api/apierr",
        "//internal/auth",
        "//internal/collector",
        "//internal/events",
        "//internal/holds",
        "//internal/ledger",
        "//internal/reported",
        "//internal/rules",
        "//internal/settings",
        "//internal/store",
        "//pkg/hourglass",
        "//pkg/hourglasstest",
        "@com_github_getkin_kin_openapi//openapi3",
        "@com_github_getkin_kin_openapi//openapi3filter",
        "@com_github_getkin_kin_openapi//routers",
        "@com_github_getkin_kin_openapi//routers/legacy",
    ],
)

# The source scan in internal/api/registration_test.go reads these files.
filegroup(
    name = "go_sources",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    visibility = ["//internal/api:__pkg__"],
)
