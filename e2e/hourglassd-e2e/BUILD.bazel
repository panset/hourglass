# SPDX-License-Identifier: MIT
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "hourglassd-e2e_lib",
    srcs = [
        "clock.go",
        "main.go",
    ],
    importpath = "github.com/panset/hourglass/e2e/hourglassd-e2e",
    visibility = ["//deploy/images:__pkg__"],
    deps = [
        "//hooks/webhook",
        "//internal/app",
        "//internal/uiserve",
        "//internal/version",
        "//pkg/hourglass",
        "//pkg/hourglass/server",
        "//policies/default",
        "//pressure/inventory",
        "//providers/static",
        "//providers/vsphere",
    ],
)

# Bundled (with the UI), like //cmd/hourglassd:hourglassd.
go_binary(
    name = "hourglassd-e2e",
    embed = [":hourglassd-e2e_lib"],
    gotags = ["ui"],  # keep
    visibility = ["//visibility:public"],
)

# API-only, like //cmd/hourglassd:hourglassd-api.
go_binary(
    name = "hourglassd-api-e2e",
    embed = [":hourglassd-e2e_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "hourglassd-e2e_test",
    srcs = ["clock_test.go"],
    embed = [":hourglassd-e2e_lib"],
)
