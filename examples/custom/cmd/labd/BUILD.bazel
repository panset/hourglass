# SPDX-License-Identifier: MIT
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "labd_lib",
    srcs = ["main.go"],
    importpath = "github.com/panset/hourglass/examples/custom/cmd/labd",
    visibility = ["//visibility:private"],
    deps = [
        "//examples/custom/busiestsite",
        "//examples/custom/businesshours",
        "//examples/custom/filedir",
        "//examples/custom/logfile",
        "//hooks/webhook",
        "//pkg/hourglass",
        "//pkg/hourglass/server",
        "//policies/default",
        "//pressure/inventory",
        "//providers/static",
    ],
)

go_binary(
    name = "labd",
    embed = [":labd_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "labd_test",
    srcs = ["main_test.go"],
    # The test starts labd with the example config and seed.
    data = [
        "//examples/custom:config.yaml",
        "//examples/custom:seed.yaml",
    ],
    embed = [":labd_lib"],
)
