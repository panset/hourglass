# SPDX-License-Identifier: MIT
load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "hourglassd_lib",
    srcs = ["main.go"],
    importpath = "github.com/panset/hourglass/cmd/hourglassd",
    visibility = ["//deploy/images:__pkg__"],
    deps = [
        "//hooks/webhook",
        "//internal/app",
        "//internal/uiserve",
        "//internal/version",
        "//pkg/hourglass",
        "//pkg/hourglass/server",
        "//policies/default",
        "//pressure/inventory",
        "//providers/static",
        "//providers/vsphere",
    ],
)

# The bundled binary: the "ui" tag turns on internal/uiserve's embed, and
# //ui:dist is copied in as its embedsrcs (UI-3, "Images": hourglass).
go_binary(
    name = "hourglassd",
    embed = [":hourglassd_lib"],
    gotags = ["ui"],  # keep
    visibility = ["//visibility:public"],
)

# The same sources without the tag: API-only (UI-3 split mode,
# "Images": hourglass-api). No Node, no built UI needed.
go_binary(
    name = "hourglassd-api",
    embed = [":hourglassd_lib"],
    visibility = ["//visibility:public"],
)

# Runs both binaries (UI-3): API-only has no UI at /, bundled serves it and
# falls back to index.html for client routes.
sh_test(
    name = "ui_modes_test",
    size = "medium",
    srcs = ["ui_modes_test.sh"],
    args = [
        "$(rootpath :hourglassd-api)",
        "$(rootpath :hourglassd)",
    ],
    data = [
        ":hourglassd",
        ":hourglassd-api",
    ],
    tags = ["local"],
)

# The source scan in internal/api/registration_test.go reads these files.
filegroup(
    name = "go_sources",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    visibility = ["//internal/api:__pkg__"],
)
