load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "hourglassd_lib",
    srcs = ["main.go"],
    importpath = "github.com/panset/hourglass/cmd/hourglassd",
    visibility = ["//visibility:private"],
    deps = [
        "//hooks/webhook",
        "//internal/app",
        "//internal/version",
        "//pkg/hourglass",
        "//pkg/hourglass/server",
        "//policies/default",
        "//pressure/inventory",
        "//providers/static",
        "//providers/vsphere",
    ],
)

go_binary(
    name = "hourglassd",
    embed = [":hourglassd_lib"],
    visibility = ["//visibility:public"],
)
